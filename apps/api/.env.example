NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Cluster0
MONGODB_DB=portfolio

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-48
JWT_REFRESH_SECRET=generate-a-different-one
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
MAX_ACTIVE_SESSIONS=5

ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=at-least-12-characters

CONTENT_CACHE_TTL_MS=30000

ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=180
ANALYTICS_SALT=generate-with-openssl-rand-hex-32
CONTACT_MAX_PER_HOUR=5
CONTACT_MIN_DWELL_MS=2000

ASK_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ASK_ENABLED=true
ASK_MODEL=
ASK_MAX_TOKENS=400
ASK_THINKING_BUDGET=0
ASK_MAX_PER_HOUR=8
ASK_MAX_PER_DAY=25
ASK_RETENTION_DAYS=90
ASK_TIMEOUT_MS=20000

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_CACHE_TTL_MS=15000
